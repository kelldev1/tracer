# Comptes admin seedés au démarrage du backend (format: email:motdepasse:nom,...)
# Ce fichier est un exemple — copie-le en .env et renseigne tes vraies valeurs.
# Ne jamais committer .env (déjà gitignored).
ADMIN_SEED=admin@example.com:changeme123:Admin

# Clés API optionnelles (sans clé = mode gratuit limité, la source est juste ignorée)
SHODAN_API_KEY=
HIBP_API_KEY=
NUMVERIFY_API_KEY=
ABUSEIPDB_API_KEY=
VIRUSTOTAL_API_KEY=
SECURITYTRAILS_API_KEY=
